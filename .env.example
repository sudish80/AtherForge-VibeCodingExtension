# Atherforge Environment Configuration
# Copy this file to .env and fill in your values

# Runtime Environment
NODE_ENV=development

# Debug Mode
VSCODE_DEBUG=false

# Model Configuration
# Add your API keys here (get them from the respective providers)

# Frontend Code LLaMA
FRONTEND_CODE_LLAMA_BASE_URL=https://api.example.com/frontend
FRONTEND_CODE_LLAMA_API_KEY=your-frontend-key-here
FRONTEND_CODE_LLAMA_MODEL=code-llama

# Backend Claude
BACKEND_CLAUDE_BASE_URL=https://api.example.com/backend
BACKEND_CLAUDE_API_KEY=your-backend-key-here
BACKEND_CLAUDE_MODEL=claude-3.5-sonnet

# Reasoning LLaMA
REASONING_LLAMA_BASE_URL=https://api.example.com/reasoning
REASONING_LLAMA_API_KEY=your-reasoning-key-here
REASONING_LLAMA_MODEL=llama-3-32k

# GitHub Configuration
GITHUB_TOKEN=ghp_your-github-token-here
GITHUB_API_BASE_URL=https://api.github.com

# Build Configuration
BUILD_MODE=development
SOURCE_MAPS=true
OPTIMIZATION=false

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/atherforge.log

# Extension Configuration
VSCODE_API_VERSION=1.109.0
EXTENSION_NAME=atherforge
EXTENSION_DEBUG=false
